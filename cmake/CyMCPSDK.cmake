set(CYMCP_BUILD_PLATFORM ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_HTTP ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_MCP ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_AI ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_LOCAL OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_CHAT_UI OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_CHAT_APP OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
add_subdirectory(third_party/cymcpsdk EXCLUDE_FROM_ALL)
file(READ "${PROJECT_SOURCE_DIR}/sdk/operations.json" CYURIUM_OPERATIONS_JSON)
string(REPLACE "\n" ")CYURIUM\"\nR\"CYURIUM(" CYURIUM_OPERATIONS_JSON "${CYURIUM_OPERATIONS_JSON}")
configure_file(src/automation_catalog_data.hpp.in generated/automation_catalog_data.hpp @ONLY)
add_library(cyurium_automation src/automation_catalog.cpp src/automation_storage.cpp src/automation_legacy.cpp)
target_include_directories(cyurium_automation PUBLIC src "${PROJECT_BINARY_DIR}/generated")
target_link_libraries(cyurium_automation PUBLIC CyMCP::MCP CyMCP::AI cyurium_core)
if(WIN32)
  target_link_libraries(cyurium_automation PUBLIC shell32)
endif()
if(MSVC)
  target_compile_options(cyurium_automation PUBLIC /utf-8)
endif()
add_executable(CyUriumCLI src/automation_cli.cpp src/automation_agent.cpp)
target_link_libraries(CyUriumCLI PRIVATE cyurium_automation)
target_compile_definitions(CyUriumCLI PRIVATE CYURIUM_VERSION="${PROJECT_VERSION}")
