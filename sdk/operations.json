  {
    "name": "page_capture",
    "description": "Capture a page as an immutable text resource; follow its chunk references to retrieve the complete snapshot.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Exact HTTP(S) URL. Local files and privileged URLs are excluded."
        },
        "maxChars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 65536,
          "default": 16000
        }
      },
      "required": [
        "tabId",
        "url"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mimeType": {
          "type": "string"
        },
        "chunked": {
          "type": "boolean"
        },
        "expiresInMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "uri",
        "bytes",
        "mimeType",
        "chunked",
        "expiresInMs"
      ]
    },
    "readOnly": true
  }
]
