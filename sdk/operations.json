          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Exact HTTP(S) URL. Local files and privileged URLs are excluded."
        },
        "maxChars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 65536,
          "default": 16000
