          "text"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "permissions": [
        "assistant.use"
      ],
      "supportedBackends": [
        "cy-providers"
      ],
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false,
      "resourceRequirements": {
        "ramBytes": 1048576
      },
      "exclusiveGroups": []
    },
    {
      "id": "assistant_close",
      "name": "assistant_close",
      "description": "Close the calling session's provider conversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
