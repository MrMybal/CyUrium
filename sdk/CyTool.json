    },
    {
      "id": "assistant_send",
      "name": "assistant_send",
      "description": "Send one conversation turn through the integrated Cy providers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "maxLength": 100
          },
          "text": {
